{{# Copy-link + optional Google Maps export — Wanderlog-style share bar #}}
<div class="trip-share" data-trip-share>
  <button type="button" class="trip-share-btn" data-share-copy>
    Copy link
  </button>
  {{ if gmapsUrl }}
    <a
      class="trip-share-btn trip-share-btn--gmaps"
      href="{{ gmapsUrl }}"
      target="_blank"
      rel="noopener noreferrer"
      data-gmaps-export
    >Open in Google Maps</a>
  {{ /if }}
  <span class="trip-share-status" data-share-status hidden>Copied</span>
</div>
<script type="module">
  const root = document.currentScript.previousElementSibling?.matches?.("[data-trip-share]")
    ? document.currentScript.previousElementSibling
    : document.querySelector("[data-trip-share]");
  const btn = root?.querySelector("[data-share-copy]");
  const status = root?.querySelector("[data-share-status]");
  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (status) {
        status.hidden = false;
        setTimeout(() => { status.hidden = true; }, 1600);
      }
    } catch {
      prompt("Copy this link:", window.location.href);
    }
  });
</script>
