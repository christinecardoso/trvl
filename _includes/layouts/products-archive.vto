---
layout: layouts/base.vto
bodyClass: body-product-archive
---

<main class="{{ it.bodyClass }}">
  <header class="page-header">
    <h1 class="page-title">{{ title }}</h1>
  </header>

  <section class="archive-main">
    {{ include "templates/product-list.vto" { productslist: results } }}

    <div class="archive-filters">
      {{ if pagination.page === 1 }}
        {{
          set pageCategories = search.pages("type=category pagination.page=1", "category")
        }}
        {{ if pageCategories.length }}
          <nav class="page-navigation">
            <h2>{{ i18n.search.categories }}</h2>
            <ul class="page-navigation-tags">
              {{ for page of pageCategories }}
                <li>
                  <a href="{{ page.url }}" class="badge">{{ page.category }}</a>
                </li>
              {{ /for }}
            </ul>
          </nav>
        {{ /if }}

{{ if type == "product" }}
  {{ set pageTags = search.pages("type=tag pagination.page=1", "tag") }}
  {{ if pageTags.length }}
    <nav class="page-navigation">
      <h2>{{ i18n.search.tags }}<span class="html-only"> 🏷️</span></h2>
      <ul class="page-navigation-tags">
        {{ for tagPage of pageTags }}
          <li>
            <a href="{{ tagPage.url }}" class="badge">{{ tagPage.tag }}</a>
          </li>
        {{ /for }}
      </ul>
    </nav>
  {{ /if }}
{{ /if }}
    </div>
  </section>

  {{ include "templates/pagination.vto" }}

  <hr>

  <p class="archive-search">{{ i18n.nav.archive_search }}</p>
  <div class="search" id="search"></div>
</main>
