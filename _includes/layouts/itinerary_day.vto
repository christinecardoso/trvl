---
layout: layouts/base.vto
---

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

{{ set it_slug = itinerary_title |> slugify }}

<main class="container mx-auto px-4 py-8">
  <header class="mb-6">
    <a class="text-sm underline" href="/itineraries/">← All Itineraries</a>
    <h1 class="text-3xl font-bold mt-1">{{ itinerary_title }} — Day {{ day_num }}</h1>

    {{ if start_date }}
      {{ set y = start_date.getUTCFullYear() }}
      {{ set m = start_date.getUTCMonth() }}
      {{ set d = start_date.getUTCDate() }}
      {{ set thisDate = new Date(Date.UTC(y, m, d + (day_num - 1))) }}
      {{ set niceDate = thisDate.toLocaleDateString("en-US", { timeZone: "UTC", weekday: "short", month: "short", day: "numeric" }) }}
      <p class="text-zinc-600">{{ niceDate }}</p>
    {{ /if }}

    <nav class="mt-2 flex gap-3">
      {{ if prev_day_url }}<a class="underline" href="{{ prev_day_url }}">← Previous</a>{{ /if }}
      {{ if next_day_url }}<a class="underline" href="{{ next_day_url }}">Next →</a>{{ /if }}
    </nav>
  </header>

  {{ if (pages?.today?.length) }}
    <section class="itinerary-list mb-4">
      {{ for p of pages.today }}
        <div class="mb-4 border-b border-gray-300 pb-4">
          <h3 class="md:text-xl font-sans">
            <a href="{{ page.url }}">{{ p.title }}</a>
            {{ if p.visit_time }}
              <span class="text-sm light:text-gray-600 italic">(Allow {{ p.visit_time }})</span>
            {{ /if }}
            {{ if p.travel_time }}
              <span class="text-sm light:text-gray-600 italic">({{ p.travel_time }})</span>
            {{ /if }}
          </h3>
          <div class="copy">
            <!-- {{ p.lat }} {{ p.lng }} -->
            {{ set raw = p.content || "" }}
            {{ set parts2 = raw.split("## Schedule") }}
            {{ set scheduleMd = parts2.length > 1 ? parts2[1] : "" }}
            {{ scheduleMd |> md }}
          </div>
        </div>
      {{ /for }}
    </section>
  {{ /if }}

</main>


<h2>Map of Quito & Nearby</h2>
<div id="map" class="h-96 rounded shadow"></div>

<script type="module">
  import { initMap } from "/js/maps.js";
  // Prefer the prebuilt array from itineraries.page.js
  const prebuilt = {{ JSON.stringify((pages && pages.mapPlaces) ? pages.mapPlaces : null) }};
  const places = prebuilt;

  if (Array.isArray(places) && places.length) {
    initMap(places);          // maps.js should accept an array of points
  } else {
    const el = document.getElementById("map");
    if (el) el.textContent = "No mapped places for this day.";
  }
</script>
