---
layout: layouts/base.vto
bodyClass: body-tag
---

<main class="{{ it.bodyClass }}">
  <header class="page-header travel-archive-header">
    <h1 class="page-title">{{ title }}</h1>
    <p class="travel-archive-intro">Experiences to add to an itinerary or your bucket list. Filter by destination or distance from base.</p>
  </header>

  <div class="activity-filters" data-activity-filters>
    {{ if destinations?.length }}
      <div class="activity-filter-group" role="group" aria-label="Destination">
        <span class="activity-filter-label">Destination</span>
        <button type="button" class="activity-filter-chip is-active" data-filter-destination="all">All</button>
        {{ for dest of destinations }}
          <button type="button" class="activity-filter-chip" data-filter-destination="{{ dest.slug }}">{{ dest.title }}</button>
        {{ /for }}
      </div>
    {{ /if }}

    {{ if categories?.length }}
      <div class="activity-filter-group" role="group" aria-label="Category">
        <span class="activity-filter-label">Distance</span>
        <button type="button" class="activity-filter-chip is-active" data-filter-category="all">All</button>
        {{ for cat of categories }}
          <button type="button" class="activity-filter-chip" data-filter-category="{{ cat.key }}">{{ cat.label }} <span class="activity-filter-n">{{ cat.count }}</span></button>
        {{ /for }}
      </div>
    {{ /if }}
  </div>

  <p class="activity-filter-status" data-filter-status hidden></p>

  <section class="travel-archive" aria-label="{{ title }}">
    {{ if results?.length }}
      <ul class="dest-grid" data-activity-grid>
        {{ for page of results }}
          {{ set destKey = page.destination_slug || page.hub || page.base || "" }}
          {{ set catKey = page.travel_category || "More" }}
          <li
            class="dest-card"
            data-destination="{{ destKey }}"
            data-category="{{ catKey }}"
          >
            <a href="{{ page.url }}">
              <span class="itin-card-eyebrow">
                {{ page.travel_category || page.country || page.kind || "Activity" }}
              </span>
              <h2 class="itin-card-title">{{ page.title }}</h2>
              <p class="itin-card-meta">
                {{ if page.country }}<span>{{ page.country }}</span>{{ /if }}
                {{ if page.visit_time }}<span>{{ page.visit_time }}</span>{{ /if }}
                {{ if page.travel_time }}<span>{{ page.travel_time }}</span>{{ /if }}
              </p>
              {{ if page.tags?.length }}
                <p class="dest-card-tags">
                  {{ for tag of page.tags.slice(0, 3) }}
                    <span class="badge">{{ tag }}</span>
                  {{ /for }}
                </p>
              {{ /if }}
            </a>
          </li>
        {{ /for }}
      </ul>
      <p class="itin-empty" data-filter-empty hidden>No experiences match these filters.</p>
    {{ else }}
      <p class="itin-empty">Nothing here yet.</p>
    {{ /if }}
  </section>

  <hr>

  <p class="archive-search">{{ i18n.nav.archive_search }}</p>
  <div class="search" id="search"></div>
</main>

<script type="module">
  const root = document.querySelector("[data-activity-filters]");
  const grid = document.querySelector("[data-activity-grid]");
  if (root && grid) {
    const cards = [...grid.querySelectorAll(".dest-card")];
    const empty = document.querySelector("[data-filter-empty]");
    const status = document.querySelector("[data-filter-status]");
    let destination = "all";
    let category = "all";

    const params = new URLSearchParams(location.search);
    if (params.get("destination")) destination = params.get("destination");
    if (params.get("category")) category = params.get("category");

    function syncChips() {
      for (const btn of root.querySelectorAll("[data-filter-destination]")) {
        btn.classList.toggle("is-active", btn.dataset.filterDestination === destination);
      }
      for (const btn of root.querySelectorAll("[data-filter-category]")) {
        btn.classList.toggle("is-active", btn.dataset.filterCategory === category);
      }
    }

    function apply() {
      let visible = 0;
      for (const card of cards) {
        const destOk = destination === "all" || card.dataset.destination === destination;
        const catOk = category === "all" || card.dataset.category === category;
        const show = destOk && catOk;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (empty) empty.hidden = visible !== 0;
      if (status) {
        const parts = [];
        if (destination !== "all") parts.push(destination);
        if (category !== "all") parts.push(category);
        status.hidden = !parts.length;
        status.textContent = parts.length
          ? `Showing ${visible} of ${cards.length} · ${parts.join(" · ")}`
          : "";
      }
      const next = new URL(location.href);
      if (destination === "all") next.searchParams.delete("destination");
      else next.searchParams.set("destination", destination);
      if (category === "all") next.searchParams.delete("category");
      else next.searchParams.set("category", category);
      history.replaceState(null, "", next);
      syncChips();
    }

    root.addEventListener("click", (e) => {
      const destBtn = e.target.closest("[data-filter-destination]");
      const catBtn = e.target.closest("[data-filter-category]");
      if (destBtn) {
        destination = destBtn.dataset.filterDestination;
        apply();
      } else if (catBtn) {
        category = catBtn.dataset.filterCategory;
        apply();
      }
    });

    apply();
  }
</script>
