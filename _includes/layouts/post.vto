---
layout: layouts/base.vto
bodyClass: body-post
---

<main class="{{ it.bodyClass }}">
  <article class="post" data-pagefind-body data-title="{{ title }}" data-pagefind-index-attrs="data-title">
    <header class="post-header">
      <h1 class="post-title">{{ title }}</h1>

      {{ include "templates/post-details.vto" }}

      {{ include "templates/post-memberships.vto" { memberships } }}

      {{ if visit_time || travel_time || travel_category || (!is_itinerary_day_plan && schedule?.length) || places?.length || options?.length }}
        <p class="itin-stop-meta">
          {{ if !is_itinerary_day_plan && schedule?.length }}<span>{{ schedule.length }} timed slots</span>{{ /if }}
          {{ if options?.length }}<span>{{ options.length }} options</span>{{ /if }}
          {{ if places?.length }}<span>{{ places.length }} places</span>{{ /if }}
          {{ if visit_time }}<span>Allow {{ visit_time }}</span>{{ /if }}
          {{ if travel_time }}<span>{{ travel_time }} travel</span>{{ /if }}
          {{ if travel_category }}<span>{{ travel_category }}</span>{{ /if }}
        </p>
      {{ /if }}
    </header>

    {{# Day-plan guides still list Pick one — the itinerary day page owns the timed map #}}
    {{ if options?.length && (is_itinerary_day_plan || !schedule?.length) }}
      {{ include "templates/stop-options.vto" { options, heading: "Pick one" } }}
    {{ /if }}

    {{ if is_itinerary_day_plan }}
      {{ include "templates/day-plan-cta.vto" }}
    {{ /if }}

    {{ if !is_itinerary_day_plan }}
      {{ include "templates/stop-schedule.vto" { schedule, heading: "Day plan" } }}
    {{ /if }}
    {{ include "templates/stop-weekly.vto" { weekly } }}
    {{ if is_itinerary_day_plan && places?.length }}
      {{ include "templates/place-collection.vto" { places, heading: "Places on this day" } }}
    {{ /if }}
    {{ if !is_itinerary_day_plan }}
      {{ if places?.length && (!schedule?.length || visit_style === "Circuit") }}
        {{ include "templates/place-collection.vto" { places, heading: "Places in this stop" } }}
      {{ /if }}
    {{ /if }}

    {{ if toc.length }}
    <nav class="toc">
      <h2>{{ i18n.nav.toc }}</h2>
      <ol>
        {{ for item of toc }}
        <li>
          <a href="#{{ item.slug }}">{{ item.text }}</a>

          {{ if item.children.length }}
          <ul>
            {{ for child of item.children }}
            <li>
              <a href="#{{ child.slug }}">{{ child.text }}</a>
            </li>
            {{ /for }}
          </ul>
          {{ /if }}
        </li>
        {{ /for }}
      </ol>
    </nav>
    {{ /if }}

    {{ set raw = content || "" }}
    {{ set afterMore = raw.split(/<!--\s*more\s*-->/i) }}
    {{ set mainRaw = afterMore.length > 1 ? afterMore[1] : raw }}
    {{ set scheduleParts = mainRaw.split("## Schedule") }}
    {{ set mainRaw = scheduleParts[0] }}

    <div class="post-body body">
      {{ mainRaw |> md }}
    </div>

    {{ if it.footnotes.length }}
    <aside role="note" class="footnotes">
      <dl>
        {{ for note of footnotes }}
        <div id={{ note.id }} class="footnote">
          <dt><a href="#{{ note.refId }}">{{ note.label }}</a></dt>
          <dd>{{ note.content }}</dd>
        </div>
        {{ /for }}
      </dl>
    </aside>
    {{ /if }}
  </article>

  <nav class="page-pagination pagination">
    <ul>
      {{- set previousPost = search.previousPage(url, "type=post") }}
      {{- if previousPost }}
      <li class="pagination-prev">
        <a href="{{ previousPost.url }}" rel="prev">
          <span>{{ i18n.nav.previous_post }}</span>
          <strong>{{ previousPost.title }}</strong>
        </a>
      </li>
      {{ /if }}

      {{- set nextPost = search.nextPage(url, "type=post") }}
      {{- if nextPost }}
      <li class="pagination-next">
        <a href="{{ nextPost.url }}" rel="next">
          <span>{{ i18n.nav.next_post }}</span>
          <strong>{{ nextPost.title }}</strong>
        </a>
      </li>
      {{ /if }}
    </ul>
  </nav>
</main>