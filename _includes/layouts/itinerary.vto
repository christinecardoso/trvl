---
layout: layouts/base.vto
bodyClass: body-post
---

<main class="{{ it.bodyClass }}">
  <header class="page-header">
    <h1 class="page-title">{{ title }}</h1>
  </header>
  <section class="itinerary-main"> 

    {{ set slug = title |> slugify }}

    <!-- /* Normalize start_date to a pure UTC date (no TZ shifts) */ -->
    {{ set hasStart = !!start_date }}
    {{ set baseY = hasStart ? start_date.getUTCFullYear() : null }}
    {{ set baseM = hasStart ? start_date.getUTCMonth() : null }}
    {{ set baseD = hasStart ? start_date.getUTCDate() : null }}

<ol class="grid gap-6">
  {{ set slug = title |> slugify }}

  {{ set hasStart = !!start_date }}
  {{ set baseY = hasStart ? start_date.getUTCFullYear() : null }}
  {{ set baseM = hasStart ? start_date.getUTCMonth() : null }}
  {{ set baseD = hasStart ? start_date.getUTCDate() : null }}

  {{ set n = Number(String(days || "").trim()) }}
  {{ if Number.isNaN(n) }}{{ set n = 0 }}{{ /if }}
  {{ set daysList = Array.from({ length: n }, (_, i) => i + 1) }}

  {{ set itemsByDay  = search.pages(`itinerary_slug=${slug}`, "itinerary_day")  || [] }}
  {{ set itemsByDays = search.pages(`itinerary_slug=${slug}`, "itinerary_days") || [] }}
  {{ set allItems    = itemsByDay.concat(itemsByDays) }}


  {{ set itemsByDay  = search.pages(`itinerary_slug=${slug}`, "itinerary_day")  || [] }}
  {{ set itemsByDays = search.pages(`itinerary_slug=${slug}`, "itinerary_days") || [] }}
  {{ set allItems    = itemsByDay.concat(itemsByDays) }}

  <!-- /* De-duplicate by URL (or src.path fallback) */ -->
  {{ set allItems = allItems.reduce((acc, p) => {
    const k = (p && p.url) ? p.url : ((p.src && p.src.path) ? p.src.path : null);
    if (!k) { acc.list.push(p); return acc; }
    if (!acc.seen[k]) { acc.seen[k] = true; acc.list.push(p); }
    return acc;
  }, { seen: {}, list: [] }).list }}



  {{ set getKeys = (pg) => {
    const out = [];
    const a = pg.itinerary_days;
    const b = pg.itinerary_day;
    if (Array.isArray(a)) a.forEach((x) => out.push(String(x)));
    else if (typeof a !== "undefined" && a !== null) out.push(String(a));
    if (typeof b !== "undefined" && b !== null) out.push(String(b));
    return out;
  } }}

  {{ for dayNum of daysList }}
    {{ set idx = dayNum - 1 }}
    {{ set thisDate = hasStart ? new Date(Date.UTC(baseY, baseM, baseD + idx)) : null }}
    {{ set niceDate = thisDate ? thisDate.toLocaleDateString("en-US", { timeZone: "UTC", weekday: "short", month: "short", day: "numeric" }) : "" }}

    <li>
      <h2 class="text-2xl font-sans">
        <a href="/itineraries/{{ slug }}/day-{{ dayNum }}/">
        Day {{ dayNum }}{{ if niceDate }} · {{ niceDate }}{{ /if }}
        </a>
      </h2>

      {{ set matches = allItems.filter((p) => {
        const keys = getKeys(p);
        if (!keys.length) return false;
        const onlyNum = (s) => (String(s).match(/\d+/) || [null])[0];
        return keys.some((k) =>
          k === String(dayNum) || (onlyNum(k) && onlyNum(k) === String(dayNum))
        );
      }) }}

      {{ set sortedMatches = matches.slice().sort((a, b) => {
        // 1) Lodging first (case-insensitive)
        const ak = String(a.kind || "").toLowerCase() === "lodging" ? 0 : 1;
        const bk = String(b.kind || "").toLowerCase() === "lodging" ? 0 : 1;
        if (ak !== bk) return ak - bk;

        // 2) Then numeric 'order' (coerce strings like "10" to numbers)
        const aoRaw = Number(a.order);
        const boRaw = Number(b.order);
        const ao = isNaN(aoRaw) ? 9999 : aoRaw;
        const bo = isNaN(boRaw) ? 9999 : boRaw;
        if (ao !== bo) return ao - bo;

        // 3) Optional: if you also have a time field like "09:30", sort by that
        // (uncomment if useful)
        // const at = String(a.time || a.start_time || "").padStart(5, "0");
        // const bt = String(b.time || b.start_time || "").padStart(5, "0");
        // if (at && bt && at !== bt) return at.localeCompare(bt);

        // 4) Finally by title
        return String(a.title || "").localeCompare(String(b.title || ""));
      }) }}

      {{ if sortedMatches.length === 0 }}
        <p class="opacity-60">No items for Day {{ dayNum }} yet.</p>
      {{ /if }}

      {{ for page of sortedMatches }}
        <div class="mt-2 pb-4 border-b border-zinc-200">
          {{ if page.kind === "lodging" }}
            <h3 class="text-xl font-semibold text-blue-900">Stay</h3>
          {{ /if }}

          <h3 class="text-xl font-sans">
            <a href="{{ page.url }}">{{ page.title }}</a>
            {{ if page.visit_time }}
            <span class="text-xl text-gray-600 italic">(Allow {{ page.visit_time }})</span>
            {{ /if }}
            {{ if page.travel_time }}
            <span class="text-xl text-gray-600 italic">({{ page.travel_time }})</span>
            {{ /if }}
          </h3>

          {{ set raw = page.content || "" }}
          {{ set parts = raw.split("## Schedule") }}
          {{ set scheduleMd = parts.length > 1 ? parts[1] : "" }}
          {{ scheduleMd |> md }}
        </div>
      {{ /for }}
    </li>
  {{ /for }}

  <div class="hidden text-xs opacity-60">
    days={{ n }}, allItems={{ allItems.length }}, slug="{{ slug }}"
  </div>
</ol>

  </section>
</main>