<!doctype html>

<html lang="{{ it.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ it.title || metas.title }} - {{ metas.site }}</title>

    <link rel="stylesheet" href="/color-options.css">
    <link rel="stylesheet" href="/styles.css">
    <link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ metas.site }}">
    <link rel="alternate" href="/feed.json" type="application/json" title="{{ metas.site }}">
    <link rel="canonical" href="{{ url |> url(true) }}">

    <meta name="supported-color-schemes" content="light dark">
    <meta name="theme-color" content="hsl(var(--a), 20%, 100%)" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="hsl(var(--a), 65%, 0%)" media="(prefers-color-scheme: dark)">

    {{ it.extra_head?.join("\n") }}
  </head>
  <body>
    {{ include "partials/nav.vto" }}

    <div id="main">
      {{ content }}
    </div>

    <footer class="site-footer center">
      <nav class="footer-nav" aria-label="Footer">
        <a href="/itineraries/">Itineraries</a>
        <a href="/countries/">Countries</a>
        <a href="/destinations/">Destinations</a>
        <a href="/bucket-list/">Bucket List</a>
        <a href="/activities/">Things to Do</a>
      </nav>
      <p class="feed-bar">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="3" cy="13" r="2" fill="currentColor"/><path d="M14 13C14 6.925 9.075 2 3 2M9 13a6 6 0 0 0-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Feed: <a href="/feed.xml">Atom</a>, <a href="/feed.json">JSON</a>
      </p>
      {{ copyright |> md }}
    </footer>
    <!-- Current page: {{ url }} -->
  </body>
</html>